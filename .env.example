# Browser-visible key used by the contact form widget.
VITE_TURNSTILE_SITE_KEY=

# Server-only values. Configure them in Vercel; never prefix them with VITE_.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=contact_form
TURNSTILE_ALLOWED_HOSTNAMES=ceniza-web.vercel.app,www.cenizaproducciones.com,cenizaproducciones.com

# Private server-to-server destinations. Never prefix these values with VITE_.
CRM_INTAKE_URL=
CRM_INTAKE_TOKEN=
